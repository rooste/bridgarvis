# Copy to local.env (gitignored) and load before running cdk:
#   set -a; source local.env; set +a
AWS_PROFILE=your-profile
AWS_REGION=us-east-1
BRIDGARVIS_ZONE=example.com          # Route53 hosted zone
BRIDGARVIS_HOST=bridgarvis.example.com
BRIDGARVIS_SITE_HOST=www.example.com   # public program website
BRIDGARVIS_SITE_ALIASES=example.com   # optional: more names for the same website, comma-separated
SITE_OWNER_LOCATION="City, State, USA"
SITE_OWNER_NAME="Your Name"
SITE_CONTACT_EMAIL=contact@example.com
BRIDGARVIS_MAIL_TEST_DOMAIN=in.example.com   # SES receiving test subdomain
BRIDGARVIS_JUUJARVIS_ADDRESS=assistant@example.com   # mail handed to the assistant, comma-separated
BRIDGARVIS_NOTIFY_ADDRESSES=info@in.example.com   # notify-only mailboxes, comma-separated
BRIDGARVIS_MAIL_UI_HOST=mail.example.com   # old mail UI name, redirected to the gateway UI
BRIDGARVIS_MAIL_FROM_ADDRESS=assistant@example.com   # the only address the gateway may send from
BRIDGARVIS_SCHOOL_ADDRESSES=school@example.com   # school mailbox(es)
BRIDGARVIS_SCHOOL_SENDER_DOMAINS=district.example.org   # allowed school sender domains
BRIDGARVIS_RESPONDER_ADDRESSES=customer*@example.com   # test mailbox(es); "prefix*@domain" = every address starting with prefix
BRIDGARVIS_RESPONDER_SENDER_DOMAINS=crm.example.com   # sender domains allowed to trigger them
BRIDGARVIS_ALEXA_HOST=alexa.example.com   # optional: Alexa skill endpoint name
BRIDGARVIS_ALEXA_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000   # Alexa custom skill id
BRIDGARVIS_ALEXA_VOICE=Brian   # optional: Amazon Polly voice for Alexa answers
BRIDGARVIS_ALEXA_PRONUNCIATIONS="Alex=Alecks"   # optional: how Alexa should say names, Word=Respelling,...
BRIDGARVIS_ALEXA_SMARTHOME_SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000   # optional: "Juujarvis Sensors" smart home skill
